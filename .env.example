# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo del turno conversacional. effort=low mantiene la latencia baja en voz.
MODELO_AGENTE=claude-opus-5
ESFUERZO_AGENTE=low

# --- Base de datos ---
# SQLite para desarrollo. En produccion: postgresql://...
DB_URL=sqlite:///data/agente.db

# --- Tenant / giro activo ---
TENANT=demo
GIRO=granos

# --- Twilio (solo para el canal de voz) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL publica de tu servidor WebSocket, ej: wss://tu-dominio.com/voz
URL_WEBSOCKET_VOZ=

# --- Operacion ---
# Minutos que dura una reserva suave antes de liberarse sola
TTL_RESERVA_MIN=30
# Si es true, ningun pedido se escribe al ERP sin aprobacion humana
REQUIERE_APROBACION_HUMANA=true

# --- Carril rapido (frase-puente mientras el modelo grande trabaja) ---
USAR_PUENTE=true
MODELO_PUENTE=claude-haiku-4-5
# Si el modelo grande contesta antes de estos ms, el puente se descarta
UMBRAL_PUENTE_MS=450

# --- Modo demostracion ---
# true = corre todo el sistema sin llamar a ningun modelo (no cuesta nada)
MODO_DEMO=false
